#!/bin/sh

. /lib/functions.sh

TMP_DIR="${TMPDIR:-/tmp}"
STATE_FILE="$TMP_DIR/wireless-helper.devices.$$"
PLAN_FILE="$TMP_DIR/wireless-helper.plan.$$"
KNOWN_FILE="$TMP_DIR/wireless-helper.known.$$"
IFACE_FILE="$TMP_DIR/wireless-helper.ifaces.$$"
WIRELESS_STATUS_FILE="$TMP_DIR/wireless-helper.ubus.$$"
DNS_SERVER_FILE="$TMP_DIR/wireless-helper.dns.$$"
WATCHDOG_LOG="$TMP_DIR/wireless-helper.watchdog.log"

cleanup_tmp() {
	rm -f "$STATE_FILE" "$PLAN_FILE" "$KNOWN_FILE" "$IFACE_FILE" "$WIRELESS_STATUS_FILE" "$DNS_SERVER_FILE"
}
trap cleanup_tmp EXIT

usage() {
	cat <<'EOF'
用法: wireless-helper status|list-radios|dry-run|clean|remember|health|recover|dns-status|dns-apply|dns-restore|watch

status      显示 USB Wi-Fi 设备分组、正在工作的 radio 和新增项。
list-radios 输出 LuCI 下拉框使用的 radio 选项。
dry-run     预览将要删除的重复 wifi-device 配置。
clean       迁移 wifi-iface 引用，删除重复 wifi-device 配置，
            提交 /etc/config/wireless，并按需重载 Wi-Fi。
remember    将当前检测到的匹配 radio 保存为已知基线。
health      检查 netifd 报告的无线状态，异常时返回非 0。
recover     立即按配置的策略恢复异常 radio。
dns-status  显示 dnsmasq 接管状态和 Clash/Mihomo DNS 监听状态。
dns-apply   备份 dnsmasq 设置并将 DNS 转发到 Clash/Mihomo。
dns-restore 恢复接管前的 dnsmasq 设置。
watch       持续监控，达到连续失败阈值后自动恢复。
EOF
}

get_setting() {
	local value
	value="$(uci -q get "wireless_helper.settings.$1")"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$2"
}

normalize_path() {
	local path="$1"
	local prefix="$2"

	case "$path" in
		"$prefix"/usb*/*-1/*-1:1.0) ;;
		*) return 1 ;;
	esac

	printf '%s\n' "$path" | sed -r 's#/usb[0-9]+/[0-9]+-1/[0-9]+-1:#/usbX/X-1/X-1:#'
}

collect_known_radio() {
	local radio="$1"

	[ -n "$radio" ] && echo "$radio" >> "$KNOWN_FILE"
}

build_known() {
	: > "$KNOWN_FILE"
	config_load wireless_helper
	config_list_foreach settings known_radio collect_known_radio
}

is_known_radio() {
	grep -qx "$1" "$KNOWN_FILE" 2>/dev/null
}

append_iface() {
	local device="$1"
	local iface="$2"

	if grep -q "^$device|" "$IFACE_FILE" 2>/dev/null; then
		sed -i "s#^$device|#&$iface,#" "$IFACE_FILE"
	else
		printf '%s|%s,\n' "$device" "$iface" >> "$IFACE_FILE"
	fi
}

collect_iface() {
	local iface="$1"
	local device disabled ifname network mode

	config_get device "$iface" device
	[ -n "$device" ] || return 0

	config_get disabled "$iface" disabled 0
	[ "$disabled" = "1" ] && return 0

	config_get ifname "$iface" ifname
	config_get network "$iface" network
	config_get mode "$iface" mode

	append_iface "$device" "$iface"
	[ -n "$ifname" ] && append_iface "$device" "$ifname"
	[ -n "$network" ] && append_iface "$device" "net:$network"
	[ -n "$mode" ] && append_iface "$device" "mode:$mode"
}

get_ifaces() {
	local device="$1"
	local value

	value="$(awk -F'|' -v dev="$device" '$1 == dev { print $2; exit }' "$IFACE_FILE" 2>/dev/null)"
	value="${value%,}"
	[ -n "$value" ] && printf '%s' "$value" || printf '-'
}

get_phys() {
	local path="$1"
	local dir="/sys/devices/$path/ieee80211"
	local phys phy

	if [ -d "$dir" ]; then
		for phy in "$dir"/phy*; do
			[ -e "$phy" ] || continue
			phys="${phys:+$phys,}$(basename "$phy")"
		done
	fi

	[ -n "$phys" ] && printf '%s' "$phys" || printf '-'
}

get_netifd_state() {
	local section="$1"
	local up pending

	if [ ! -s "$WIRELESS_STATUS_FILE" ] || ! command -v jsonfilter >/dev/null 2>&1; then
		printf 'unknown'
		return 0
	fi

	up="$(jsonfilter -i "$WIRELESS_STATUS_FILE" -e "@[\"$section\"].up" 2>/dev/null)"
	pending="$(jsonfilter -i "$WIRELESS_STATUS_FILE" -e "@[\"$section\"].pending" 2>/dev/null)"
	case "$up" in
		true|1) printf 'up' ;;
		false|0)
			case "$pending" in true|1) printf 'starting' ;; *) printf 'down' ;; esac
			;;
		*) printf 'unknown' ;;
	esac
}

collect_device() {
	local section="$1"
	local path disabled key exists phys ifaces active new state health

	config_get path "$section" path
	[ -n "$path" ] || return 0

	key="$(normalize_path "$path" "$PATH_PREFIX")" || return 0
	exists=0
	[ -e "/sys/devices/$path" ] && exists=1
	config_get disabled "$section" disabled 0
	phys="$(get_phys "$path")"
	ifaces="$(get_ifaces "$section")"
	active=0
	[ "$exists" = "1" ] && [ "$disabled" != "1" ] && [ "$ifaces" != "-" ] && active=1
	new=1
	is_known_radio "$section" && new=0
	state="$(get_netifd_state "$section")"
	health=0
	[ "$exists" = "1" ] && [ "$disabled" != "1" ] && [ "$ifaces" != "-" ] && \
		[ "$phys" != "-" ] && [ "$state" = "up" ] && health=1

	printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
		"$section" "$exists" "$disabled" "$key" "$path" "$phys" "$ifaces" "$active" "$new" "$state" "$health" >> "$STATE_FILE"
}

build_state() {
	: > "$STATE_FILE"
	: > "$IFACE_FILE"
	: > "$WIRELESS_STATUS_FILE"
	ubus call network.wireless status > "$WIRELESS_STATUS_FILE" 2>/dev/null || true
	build_known
	config_load wireless
	config_foreach collect_iface wifi-iface
	config_foreach collect_device wifi-device
}

build_plan() {
	local preferred="$1"

	awk -F'|' -v preferred="$preferred" '
	{
		section=$1; exists=$2; key=$4; active=$8
		count[key]++
		order[++n]=section
		keys[section]=key
		lines[section]=$0
		if (!(key in first)) first[key]=section
		if (exists == "1" && !(key in live)) live[key]=section
		if (active == "1" && !(key in active_keep)) active_keep[key]=section
		if (section == preferred) preferred_key=key
	}
	END {
		for (i = 1; i <= n; i++) {
			section=order[i]
			key=keys[section]
			keep=(key == preferred_key) ? preferred : ((key in active_keep) ? active_keep[key] : ((key in live) ? live[key] : first[key]))
			if (count[key] > 1 && section != keep) {
				print "remove|" section "|" keep "|" lines[section]
			}
		}
	}
	' "$STATE_FILE" > "$PLAN_FILE"
}

print_status() {
	local preferred="$1"

	if [ ! -s "$STATE_FILE" ]; then
		echo "未找到匹配的 USB Wi-Fi radio 路径。"
		echo "路径前缀: $PATH_PREFIX"
		return 0
	fi

	echo "默认保留 radio: ${preferred:-自动}"
	echo "路径前缀: $PATH_PREFIX"
	echo ""
	echo "匹配的 USB Wi-Fi radio 路径:"
	awk -F'|' -v preferred="$preferred" '
	{
		mark=($1 == preferred) ? "用户选择" : "-"
		printf "  %-12s 存在=%s 配置活动=%s 健康=%s netifd=%s 新增=%s 禁用=%s phy=%s 接口=%s 保留提示=%s\n", $1, $2, $8, $11, $10, $9, $3, $6, $7, mark
		printf "      路径=%s\n", $5
		groups[$4]++
	}
	END {
		print ""
		print "重复分组:"
		found=0
		for (key in groups) {
			if (groups[key] > 1) {
				found=1
				printf "  %s (%d 个 radio)\n", key, groups[key]
			}
		}
		if (!found) print "  无"
	}
	' "$STATE_FILE"
}

print_radio_choices() {
	if [ ! -s "$STATE_FILE" ]; then
		return 0
	fi

	awk -F'|' '
	{
		printf "%s|%s 存在=%s 健康=%s netifd=%s 新增=%s phy=%s 接口=%s 路径=%s\n", $1, $1, $2, $11, $10, $9, $6, $7, $5
	}
	' "$STATE_FILE"
}

print_plan() {
	if [ ! -s "$PLAN_FILE" ]; then
		echo "没有需要清理的重复 wifi-device 配置。"
		return 0
	fi

	echo "清理计划:"
	awk -F'|' '
	{
		printf "  删除 %-12s 保留 %-12s 旧路径=%s\n", $2, $3, $8
	}
	' "$PLAN_FILE"
}

migrate_iface() {
	local iface="$1"
	local device

	config_get device "$iface" device
	[ "$device" = "$OLD_DEVICE" ] || return 0

	echo "  迁移 wifi-iface $iface: $OLD_DEVICE -> $KEEP_DEVICE"
	uci -q set "wireless.$iface.device=$KEEP_DEVICE"
}

state_value() {
	local section="$1"
	local field="$2"

	awk -F'|' -v section="$section" -v field="$field" '$1 == section { print $field; exit }' "$STATE_FILE"
}

remember_radios() {
	local radios

	uci -q delete wireless_helper.settings.known_radio
	radios="$(awk -F'|' '{ print $1 }' "$STATE_FILE")"
	for radio in $radios; do
		uci -q add_list "wireless_helper.settings.known_radio=$radio"
	done
	uci -q commit wireless_helper
	echo "已将当前检测到的 radio 保存为已知基线。"
}

apply_plan() {
	local changed=0
	local action old keep old_section old_exists old_disabled old_key old_path old_phy old_ifaces old_active old_new reload_wifi
	local keep_exists

	if [ ! -s "$PLAN_FILE" ]; then
		echo "没有需要清理的重复 wifi-device 配置。"
		remember_radios
		return 0
	fi

	while IFS='|' read -r action old keep old_section old_exists old_disabled old_key old_path old_phy old_ifaces old_active old_new old_state old_health; do
		[ "$action" = "remove" ] || continue

		OLD_DEVICE="$old"
		KEEP_DEVICE="$keep"
		export OLD_DEVICE KEEP_DEVICE

		echo "正在清理重复 wifi-device $old；保留 $keep"
		keep_exists="$(state_value "$keep" 2)"
		if [ "$keep_exists" != "1" ] && [ "$old_exists" = "1" ] && [ -n "$old_path" ]; then
			echo "  将 $old 的当前可用路径写回 $keep"
			uci -q set "wireless.$keep.path=$old_path"
			uci -q set "wireless.$keep.disabled=0"
		fi

		config_load wireless
		config_foreach migrate_iface wifi-iface
		uci -q delete "wireless.$old"
		changed=1
	done < "$PLAN_FILE"

	if [ "$changed" = "1" ]; then
		uci -q commit wireless
		echo "已提交 /etc/config/wireless。"
		build_state
		remember_radios

		reload_wifi="$(get_setting reload_wifi 0)"
		if [ "$reload_wifi" = "1" ]; then
			wifi reload
			echo "已重载 Wi-Fi。"
		fi
	fi
}

select_dnsmasq_section() {
	[ -n "$DNSMASQ_SECTION" ] || DNSMASQ_SECTION="$1"
}

get_dnsmasq_section() {
	DNSMASQ_SECTION=""
	config_load dhcp
	config_foreach select_dnsmasq_section dnsmasq
	[ -n "$DNSMASQ_SECTION" ]
}

save_dns_server() {
	printf '%s\n' "$1" >> "$DNS_SERVER_FILE"
}

collect_dns_servers() {
	: > "$DNS_SERVER_FILE"
	config_load dhcp
	config_list_foreach "$DNSMASQ_SECTION" server save_dns_server
}

dns_upstream() {
	local upstream port

	upstream="$(get_setting dns_upstream auto)"
	if [ -z "$upstream" ] || [ "$upstream" = "auto" ]; then
		port="$(uci -q get openclash.config.dns_port)"
		case "$port" in *[!0-9]*|'') port=7874 ;; esac
		upstream="127.0.0.1#$port"
	fi
	printf '%s' "$upstream"
}

validate_dns_upstream() {
	local upstream="$1"
	local host port

	case "$upstream" in
		*'#'*) host="${upstream%#*}"; port="${upstream##*#}" ;;
		*) return 1 ;;
	esac
	[ -n "$host" ] || return 1
	case "$host" in *[!A-Za-z0-9.:_%+-]*) return 1 ;; esac
	case "$port" in *[!0-9]*|'') return 1 ;; esac
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null
}

dns_listener_up() {
	local upstream="$1"
	local port

	port="${upstream##*#}"
	netstat -lnut 2>/dev/null | awk -v suffix=":$port" '
	NR > 2 {
		address=$4
		if (length(address) >= length(suffix) && substr(address, length(address) - length(suffix) + 1) == suffix) found=1
	}
	END { exit !found }
	'
}

backup_dns_option() {
	local option="$1"
	local value

	value="$(uci -q get "dhcp.$DNSMASQ_SECTION.$option")"
	[ -n "$value" ] || value="__unset__"
	uci -q set "wireless_helper.settings.backup_dns_$option=$value"
}

restore_dns_option() {
	local option="$1"
	local value

	value="$(uci -q get "wireless_helper.settings.backup_dns_$option")"
	if [ "$value" = "__unset__" ] || [ -z "$value" ]; then
		uci -q delete "dhcp.$DNSMASQ_SECTION.$option"
	else
		uci -q set "dhcp.$DNSMASQ_SECTION.$option=$value"
	fi
}

restore_dns_server() {
	uci -q add_list "dhcp.$DNSMASQ_SECTION.server=$1"
}

backup_dnsmasq() {
	local server

	[ "$(get_setting dns_backup_done 0)" = "1" ] && return 0
	collect_dns_servers
	uci -q delete wireless_helper.settings.backup_dns_server
	while IFS= read -r server; do
		[ -n "$server" ] && uci -q add_list "wireless_helper.settings.backup_dns_server=$server"
	done < "$DNS_SERVER_FILE"
	backup_dns_option noresolv
	backup_dns_option resolvfile
	backup_dns_option localuse
	backup_dns_option cachesize
	uci -q set wireless_helper.settings.dns_backup_done=1
	uci -q commit wireless_helper
}

dns_config_matches() {
	local upstream="$1"
	local server found=0 unexpected=0

	[ "$(uci -q get "dhcp.$DNSMASQ_SECTION.noresolv")" = "1" ] || return 1
	[ "$(uci -q get "dhcp.$DNSMASQ_SECTION.localuse")" = "1" ] || return 1
	[ "$(uci -q get "dhcp.$DNSMASQ_SECTION.cachesize")" = "0" ] || return 1
	[ -z "$(uci -q get "dhcp.$DNSMASQ_SECTION.resolvfile")" ] || return 1
	collect_dns_servers
	while IFS= read -r server; do
		[ "$server" = "$upstream" ] && found=1
		case "$server" in
			"$upstream"|/*) ;;
			*) [ -n "$server" ] && unexpected=1 ;;
		esac
	done < "$DNS_SERVER_FILE"
	[ "$found" = "1" ] && [ "$unexpected" = "0" ]
}

apply_dns_takeover() {
	local upstream keep_domain server

	get_dnsmasq_section || {
		echo "未找到 dnsmasq 配置节。" >&2
		return 1
	}
	upstream="$(dns_upstream)"
	validate_dns_upstream "$upstream" || {
		echo "DNS 上游格式无效: $upstream（应为 IP#端口）" >&2
		return 1
	}
	dns_listener_up "$upstream" || {
		echo "Clash/Mihomo DNS 尚未在 $upstream 监听，未修改 dnsmasq。" >&2
		return 1
	}

	backup_dnsmasq || return 1
	collect_dns_servers
	keep_domain="$(get_setting dns_keep_domain_forwards 1)"
	uci -q delete "dhcp.$DNSMASQ_SECTION.server"
	if [ "$keep_domain" = "1" ]; then
		while IFS= read -r server; do
			case "$server" in /*) uci -q add_list "dhcp.$DNSMASQ_SECTION.server=$server" ;; esac
		done < "$DNS_SERVER_FILE"
	fi
	uci -q add_list "dhcp.$DNSMASQ_SECTION.server=$upstream"
	uci -q delete "dhcp.$DNSMASQ_SECTION.resolvfile"
	uci -q set "dhcp.$DNSMASQ_SECTION.noresolv=1"
	uci -q set "dhcp.$DNSMASQ_SECTION.localuse=1"
	uci -q set "dhcp.$DNSMASQ_SECTION.cachesize=0"
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart
	echo "DNS 已接管: dnsmasq -> $upstream"
	echo "路由器本机解析已通过 dnsmasq（localuse=1）。"
}

restore_dnsmasq() {
	[ "$(get_setting dns_backup_done 0)" = "1" ] || {
		uci -q set wireless_helper.settings.dns_takeover=0
		uci -q commit wireless_helper
		echo "已关闭 DNS 同步；没有可恢复的 DNS 备份。"
		return 0
	}
	get_dnsmasq_section || return 1

	uci -q delete "dhcp.$DNSMASQ_SECTION.server"
	config_load wireless_helper
	config_list_foreach settings backup_dns_server restore_dns_server
	restore_dns_option noresolv
	restore_dns_option resolvfile
	restore_dns_option localuse
	restore_dns_option cachesize
	uci -q commit dhcp
	uci -q delete wireless_helper.settings.dns_backup_done
	uci -q delete wireless_helper.settings.backup_dns_server
	uci -q delete wireless_helper.settings.backup_dns_noresolv
	uci -q delete wireless_helper.settings.backup_dns_resolvfile
	uci -q delete wireless_helper.settings.backup_dns_localuse
	uci -q delete wireless_helper.settings.backup_dns_cachesize
	uci -q set wireless_helper.settings.dns_takeover=0
	uci -q commit wireless_helper
	/etc/init.d/dnsmasq restart
	echo "已关闭 DNS 同步并恢复接管前的 dnsmasq 配置。"
}

print_dns_status() {
	local upstream config_state listener_state resolv_state

	get_dnsmasq_section || {
		echo "dnsmasq: 未找到配置"
		return 1
	}
	upstream="$(dns_upstream)"
	dns_config_matches "$upstream" && config_state="已接管" || config_state="未接管/配置漂移"
	dns_listener_up "$upstream" && listener_state="正常" || listener_state="未监听"
	grep -q '^nameserver 127\.0\.0\.1' /etc/resolv.conf 2>/dev/null && resolv_state="已接管" || resolv_state="未指向本机"
	echo "dnsmasq 配置: $config_state"
	echo "Clash/Mihomo DNS: $upstream ($listener_state)"
	echo "路由器 resolv.conf: $resolv_state"
	echo "备份可恢复: $(get_setting dns_backup_done 0)"
	[ "$config_state" = "已接管" ] && [ "$listener_state" = "正常" ]
}

ensure_dns_takeover() {
	local upstream

	[ "$(get_setting dns_takeover 0)" = "1" ] || return 0
	get_dnsmasq_section || return 1
	upstream="$(dns_upstream)"
	if ! dns_config_matches "$upstream"; then
		echo "$(date '+%F %T') 检测到 DNS 配置漂移，正在重新接管。" > "$WATCHDOG_LOG"
		apply_dns_takeover >> "$WATCHDOG_LOG" 2>&1
		logger -t wireless-helper "已重新应用 DNS 接管"
	fi
}

unhealthy_radios() {
	awk -F'|' '$3 != "1" && $7 != "-" && $10 != "starting" && $11 != "1" { print $1 }' "$STATE_FILE"
}

print_health() {
	local failed=0

	if [ ! -s "$STATE_FILE" ]; then
		echo "未找到需要监控的 USB Wi-Fi radio。"
		return 0
	fi

	awk -F'|' '
	$3 != "1" && $7 != "-" {
		label=($11 == "1" ? "正常" : ($10 == "starting" ? "初始化中" : "异常"))
		printf "%-12s %s (netifd=%s, 路径=%s, phy=%s)\n", $1, label, $10, $2, $6
	}
	' "$STATE_FILE"

	[ -z "$(unhealthy_radios)" ] || failed=1
	return "$failed"
}

recover_radios() {
	local requested="$1"
	local targets action radio delay

	action="$(get_setting recovery_action wifi_reload)"
	delay="$(get_setting recovery_delay 3)"
	case "$delay" in *[!0-9]*|'') delay=3 ;; esac

	if [ -n "$requested" ]; then
		if ! awk -F'|' -v radio="$requested" '$1 == radio { found=1 } END { exit !found }' "$STATE_FILE"; then
			echo "未找到 radio: $requested" >&2
			return 1
		fi
		targets="$requested"
	else
		targets="$(unhealthy_radios)"
	fi

	if [ -z "$targets" ]; then
		echo "所有受管 radio 状态正常，无需恢复。"
		return 0
	fi

	case "$action" in
		network_restart)
			echo "检测到异常 radio: $(echo "$targets" | tr '\n' ' ')"
			echo "正在重启 network 服务，管理连接可能短暂中断。"
			/etc/init.d/network restart
			;;
		wifi_reload|*)
			for radio in $targets; do
				echo "正在重置 $radio ..."
				wifi down "$radio"
				sleep "$delay"
				wifi up "$radio"
			done
			;;
	esac
}

watch_radios() {
	local failures=0
	local interval threshold now targets auto_recover dns_takeover

	interval="$(get_setting check_interval 60)"
	threshold="$(get_setting failure_threshold 3)"
	case "$interval" in *[!0-9]*|'') interval=60 ;; esac
	case "$threshold" in *[!0-9]*|'') threshold=3 ;; esac
	[ "$interval" -ge 15 ] 2>/dev/null || interval=15
	[ "$threshold" -ge 1 ] 2>/dev/null || threshold=1

	echo "$(date '+%F %T') 健康监控已启动（间隔 ${interval}s，阈值 ${threshold} 次）" > "$WATCHDOG_LOG"
	while :; do
		auto_recover="$(get_setting auto_recover 0)"
		dns_takeover="$(get_setting dns_takeover 0)"
		[ "$dns_takeover" = "1" ] && ensure_dns_takeover

		if [ "$auto_recover" = "1" ]; then
			build_state
			targets="$(unhealthy_radios)"
		else
			targets=""
			failures=0
		fi
		if [ "$auto_recover" = "1" ] && [ -n "$targets" ]; then
			failures=$((failures + 1))
			now="$(date '+%F %T')"
			echo "$now 检测到异常（$failures/$threshold）: $(echo "$targets" | tr '\n' ' ')" > "$WATCHDOG_LOG"
			logger -t wireless-helper "radio 健康检查失败 $failures/$threshold: $(echo "$targets" | tr '\n' ' ')"
			if [ "$failures" -ge "$threshold" ]; then
				recover_radios "" >> "$WATCHDOG_LOG" 2>&1
				logger -t wireless-helper "已执行无线恢复策略"
				failures=0
			fi
		else
			failures=0
		fi
		sleep "$interval"
	done
}

MODE="$1"
PATH_PREFIX="$(get_setting path_prefix platform/ff5c0000.usb)"
PREFERRED_RADIO="$(get_setting preferred_radio "")"

case "$MODE" in
	status|"")
		build_state
		build_plan "$PREFERRED_RADIO"
		print_status "$PREFERRED_RADIO"
		echo ""
		print_plan
		;;
	list-radios)
		build_state
		print_radio_choices
		;;
	dry-run)
		build_state
		build_plan "$PREFERRED_RADIO"
		print_status "$PREFERRED_RADIO"
		echo ""
		print_plan
		;;
	clean)
		build_state
		build_plan "$PREFERRED_RADIO"
		print_plan
		apply_plan
		;;
	remember)
		build_state
		remember_radios
		;;
	health)
		build_state
		print_health
		;;
	recover)
		build_state
		recover_radios "${2:-$PREFERRED_RADIO}"
		;;
	dns-status)
		print_dns_status
		;;
	dns-apply)
		apply_dns_takeover
		;;
	dns-restore)
		restore_dnsmasq
		;;
	watch)
		watch_radios
		;;
	-h|--help|help)
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
